# Optional: Langfuse tracing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENABLED=false

WATCHQUEST_DATA_DIR=./data
LOG_LEVEL=INFO
# printf-style logging template or the special value "json".
LOG_FORMAT="%(asctime)s | %(levelname)s | %(name)s | %(message)s"
LOG_DATE_FORMAT="%Y-%m-%d %H:%M:%S"

# Optional: LLM core. Provider is OpenRouter (OpenAI-compatible API).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.7
# For reasoning models (gpt-5-*): cap internal thinking so answers fit max_tokens.
LLM_REASONING_EFFORT=low

# Optional: RSS fetching.
RSS_FETCH_TIMEOUT_SECONDS=20
RSS_FETCH_ITEM_LIMIT=20
RSS_FETCH_CONCURRENCY=4
RSS_USER_AGENT="WatchQuest/0.1 RSS reader (+https://github.com/IrinaMartynovaR/mcp-watchlist-provider)"
# Base URL substituted for the {rss_bridge} placeholder in data/sources.json.
# Local run: http://localhost:3001; docker compose overrides it to http://rss-bridge:80.
RSS_BRIDGE_URL=http://localhost:3001
RSS_SUMMARY_MAX_CHARS=500
RSS_BRIDGE_PLACEHOLDER={rss_bridge}

# Optional: Telegram bot long polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MAX_MESSAGE_LENGTH=3900
TELEGRAM_CANDIDATE_PREVIEW_LIMIT=5
TELEGRAM_RECOMMENDATION_LIMIT=8
TELEGRAM_RECOMMENDATION_SOURCE_LIMIT=8
# Avoid refreshing and reclassifying unchanged feeds on every Telegram request.
TELEGRAM_RSS_REFRESH_TTL_SECONDS=1800

# Optional: MCP tool defaults.
TOOLS_SOURCE_VALIDATION_LIMIT=3
TOOLS_FEED_REFRESH_LIMIT=20
TOOLS_CACHE_SEARCH_DAYS=30
TOOLS_CACHE_SEARCH_LIMIT=20
TOOLS_RECOMMENDATION_LIMIT=8
TOOLS_RECOMMENDATION_SOURCE_LIMIT=10
TOOLS_RECOMMENDATION_FALLBACK_MULTIPLIER=3
TOOLS_RECOMMENDATION_KEYWORD_MARKER=вайб
TOOLS_RECOMMENDATION_KEYWORD_VARIANTS="уютная,атмосферная,cozy,vibe"

# Optional: LLM classification of RSS entries (kind: review/release/news/noise + title entity).
# Uses a cheap model via the same OpenRouter key; verdicts are cached forever in
# data/classification_cache.json, and any LLM failure falls back to keyword heuristics.
TOOLS_CLASSIFIER_ENABLED=false
TOOLS_CLASSIFIER_MODEL=google/gemma-4-26b-a4b-it
TOOLS_CLASSIFIER_BATCH_SIZE=25
TOOLS_CLASSIFIER_CONCURRENCY=2
TOOLS_CLASSIFIER_SUMMARY_PROMPT_CHARS=200
TOOLS_CLASSIFIER_VERDICT_TOKENS=120
TOOLS_CLASSIFIER_RESPONSE_TOKENS_HEADROOM=200

# Optional: semantic RSS retrieval (RAG).
# Verify the provider's /embeddings endpoint with a real LLM_API_KEY before enabling:
# on any failure the pipeline silently falls back to naive substring retrieval.
TOOLS_RAG_ENABLED=false
# Semantic search indexes up to this many recent cache items regardless of the
# per-request candidate limit (embeddings are cached, so a wide pool is cheap).
TOOLS_RAG_POOL_LIMIT=500
TOOLS_RAG_EXACT_CATEGORY_BONUS=0.05
TOOLS_RAG_REVIEW_SCORE_BONUS=0.05
TOOLS_RAG_NOISE_SCORE_PENALTY=-0.2
TOOLS_RECOMMENDATION_REVIEW_KIND_WEIGHT=1
TOOLS_RECOMMENDATION_NOISE_KIND_WEIGHT=-2

# Optional: HyDE query augmentation for cross-lingual RAG (requires TOOLS_RAG_ENABLED=true).
# Adds one extra LLM call + one extra embedding call per semantic search — costs latency/tokens.
TOOLS_HYDE_ENABLED=false

# Optional: graph memory of user preferences (Mem0 + Memgraph).
# Requires: docker compose -f compose/docker-compose.memgraph.yml up -d
# Note: Mem0 requires non-empty credentials; a Memgraph container without auth ignores them.
TOOLS_MEMORY_ENABLED=false
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USERNAME=memgraph
MEMGRAPH_PASSWORD=
TOOLS_MEMORY_TOP_K=5

# Optional: one-time import of MyShows.me watch history into graph memory.
# Uses your real MyShows login/password (unofficial API, no OAuth app registration available).
MYSHOWS_LOGIN=
MYSHOWS_PASSWORD=
MYSHOWS_TIMEOUT_SECONDS=30
MYSHOWS_SESSION_URL=https://myshows.me/api/session
MYSHOWS_RPC_URL=https://myshows.me/v3/rpc/
MYSHOWS_MOVIES_PAGE_SIZE=20
MYSHOWS_MAX_MOVIE_PAGES=200
MYSHOWS_MOVIE_CATEGORY=movies_series
MYSHOWS_SHOW_CATEGORY=series
MYSHOWS_IMPORT_SOURCE=myshows_import
MYSHOWS_IMPORT_WEIGHT_FACTOR=0.5
MYSHOWS_POSITIVE_SHOW_STATUSES=watching,finished,watched
MYSHOWS_NEGATIVE_SHOW_STATUSES=cancelled,canceled
