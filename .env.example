# Optional: Feedly. MVP works without it via RSS.
FEEDLY_ACCESS_TOKEN=
FEEDLY_STREAM_IDS=
# Example: FEEDLY_STREAM_IDS=user/xxx/category/Games,user/xxx/category/Movies

# Optional: Langfuse tracing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

WATCHQUEST_DATA_DIR=./data

# Optional: Z.AI LLM core.
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_MODEL=glm-4.7-flash
ZAI_TIMEOUT_SECONDS=90
