# Optional: Langfuse tracing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

WATCHQUEST_DATA_DIR=./data

# Optional: LLM core. Default provider is Z.AI GLM-compatible.
LLM_PROVIDER=zai_glm
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.7

# Optional: local RSS-Bridge service.
RSS_BRIDGE_BASE_URL=http://localhost:3001
RSS_BRIDGE_TIMEOUT_SECONDS=20
RSS_FETCH_TIMEOUT_SECONDS=20
RSS_USER_AGENT="WatchQuest/0.1 RSS reader (+https://github.com/IrinaMartynovaR/mcp-watchlist-provider)"

# Optional: Telegram bot long polling.
TELEGRAM_BOT_TOKEN=
