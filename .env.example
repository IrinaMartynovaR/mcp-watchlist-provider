# Optional: Langfuse tracing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

WATCHQUEST_DATA_DIR=./data

# Optional: Z.AI LLM core.
ZAI_API_KEY=
